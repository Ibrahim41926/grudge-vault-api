generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GrudgeCategory {
  betrayal
  lies
  theft
  manipulation
  abandonment
  humiliation
  broken_promise
  gossip
  sabotage
  other
}

enum FileType {
  image
  audio
  pdf
  screenshot
  other
}

enum ReminderFrequency {
  once
  daily
  weekly
  monthly
  yearly
  custom
}

enum NotificationType {
  reminder
  system
  info
}

enum NotificationsFrequency {
  daily
  weekly
  monthly
  custom
}

enum Theme {
  dark
  light
}

enum OAuthProvider {
  google
  apple
}

// Remplace auth.users + profiles de Supabase : une seule table, source unique de vérité.
model User {
  id                     String                 @id @default(uuid()) @db.Char(36)
  email                  String                 @unique @db.VarChar(191)
  passwordHash           String?                @map("password_hash")
  fullName               String?                @map("full_name")
  username               String?                @unique @db.VarChar(191)
  avatarUrl              String?                @map("avatar_url")
  notificationsEmail     Boolean                @default(true) @map("notifications_email")
  notificationsFrequency NotificationsFrequency @default(daily) @map("notifications_frequency")
  theme                  Theme                  @default(dark)
  emailConfirmedAt       DateTime?              @map("email_confirmed_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  oauthIdentities         OAuthIdentity[]
  tags                    Tag[]
  people                  Person[]
  grudges                 Grudge[]
  uploads                 Upload[]
  reminders               Reminder[]
  notifications           Notification[]

  @@map("users")
}

// Lie un compte a une identite Google/Apple. providerUserId = le `sub` du id_token,
// verifie cote serveur (voir src/lib/oauth.ts) - jamais fourni par le client sans verification.
model OAuthIdentity {
  id             String        @id @default(uuid()) @db.Char(36)
  userId         String        @map("user_id") @db.Char(36)
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(191)
  email          String        @db.VarChar(191)
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  email      String
  tokenHash  String    @unique @map("token_hash") @db.VarChar(191)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(191)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Rotation + révocation des refresh tokens JWT. Le token en clair n'est jamais stocké, seul son hash.
model RefreshToken {
  id                String    @id @default(uuid()) @db.Char(36)
  userId            String    @map("user_id") @db.Char(36)
  tokenHash         String    @unique @map("token_hash") @db.VarChar(191)
  family            String    @db.Char(36)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Char(36)
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// Profil de personne : plusieurs rancunes peuvent pointer vers la meme Person,
// choisie manuellement (pas de matching automatique par nom).
model Person {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)

  firstName    String  @map("first_name") @db.VarChar(191)
  lastName     String? @map("last_name") @db.VarChar(191)
  nickname     String? @db.VarChar(191)
  phone        String? @db.VarChar(64)
  email        String? @db.VarChar(191)
  socialHandle String? @map("social_handle") @db.VarChar(191)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grudges Grudge[]

  @@index([userId])
  @@map("people")
}

model Tag {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  name      String   @db.VarChar(191)
  color     String   @default("#8b5cf6") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  grudgeTags GrudgeTag[]

  @@unique([userId, name])
  @@map("tags")
}

model Grudge {
  id       String  @id @default(uuid()) @db.Char(36)
  userId   String  @map("user_id") @db.Char(36)
  personId String? @map("person_id") @db.Char(36)

  firstName    String  @map("first_name") @db.VarChar(191)
  lastName     String? @map("last_name") @db.VarChar(191)
  nickname     String? @db.VarChar(191)
  phone        String? @db.VarChar(64)
  email        String? @db.VarChar(191)
  socialHandle String? @map("social_handle") @db.VarChar(191)

  title        String         @db.VarChar(255)
  description  String         @db.Text
  category     GrudgeCategory
  severity     Int
  incidentDate DateTime       @map("incident_date") @db.Date

  isArchived Boolean @default(false) @map("is_archived")
  isFavorite Boolean @default(false) @map("is_favorite")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  person        Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  grudgeTags    GrudgeTag[]
  uploads       Upload[]
  reminders     Reminder[]
  notifications Notification[]

  @@index([userId])
  @@index([personId])
  @@index([severity])
  @@index([incidentDate])
  @@index([category])
  @@index([isArchived])
  @@fulltext([firstName, lastName, nickname, title, description])
  @@map("grudges")
}

model GrudgeTag {
  grudgeId String @map("grudge_id") @db.Char(36)
  tagId    String @map("tag_id") @db.Char(36)

  grudge Grudge @relation(fields: [grudgeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([grudgeId, tagId])
  @@map("grudge_tags")
}

model Upload {
  id       String @id @default(uuid()) @db.Char(36)
  userId   String @map("user_id") @db.Char(36)
  grudgeId String @map("grudge_id") @db.Char(36)

  fileName    String   @map("file_name") @db.VarChar(255)
  fileType    FileType @map("file_type")
  fileSize    Int      @map("file_size")
  storagePath String   @map("storage_path") @db.VarChar(512)
  mimeType    String?  @map("mime_type") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  grudge Grudge @relation(fields: [grudgeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([grudgeId])
  @@map("uploads")
}

model Reminder {
  id       String @id @default(uuid()) @db.Char(36)
  userId   String @map("user_id") @db.Char(36)
  grudgeId String @map("grudge_id") @db.Char(36)

  title              String            @db.VarChar(255)
  message            String?           @db.Text
  frequency          ReminderFrequency
  customIntervalDays Int?              @map("custom_interval_days")
  nextTriggerAt      DateTime          @map("next_trigger_at")
  lastTriggeredAt    DateTime?         @map("last_triggered_at")
  isActive           Boolean           @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  grudge        Grudge         @relation(fields: [grudgeId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId])
  @@index([isActive, nextTriggerAt])
  @@map("reminders")
}

model Notification {
  id         String  @id @default(uuid()) @db.Char(36)
  userId     String  @map("user_id") @db.Char(36)
  grudgeId   String? @map("grudge_id") @db.Char(36)
  reminderId String? @map("reminder_id") @db.Char(36)

  title   String           @db.VarChar(255)
  message String           @db.Text
  type    NotificationType @default(reminder)
  isRead  Boolean          @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grudge   Grudge?   @relation(fields: [grudgeId], references: [id], onDelete: SetNull)
  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
