    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.6.1",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "resend": "^6.12.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.3.0",
    "prisma": "^6.16.3",
